{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    ":separateMajorReleases",
    "group:monorepos",
    "group:recommended",
    "schedule:weekly"
  ],
  "timezone": "Europe/Lisbon",
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "prHourlyLimit": 4,
  "prConcurrentLimit": 10,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "vulnerability"],
    "schedule": [],
    "prPriority": 10
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"]
  },
  "packageRules": [
    {
      "description": "Auto-merge patch updates of dev/test deps",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Auto-merge minor updates of safe categories",
      "matchPackagePatterns": ["^@types/", "^eslint", "^prettier", "^@typescript-eslint/"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Group all linting tools",
      "matchPackagePatterns": ["eslint", "prettier", "stylelint", "ruff", "black", "isort"],
      "groupName": "linting tools"
    },
    {
      "description": "Group testing tools",
      "matchPackagePatterns": ["jest", "vitest", "mocha", "pytest", "phpunit", "playwright"],
      "groupName": "testing tools"
    },
    {
      "description": "Pin GitHub Actions to digests for security",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "Major updates need manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major-update", "needs-review"]
    }
  ],
  "ignoreDeps": [],
  "commitMessagePrefix": "chore(deps):",
  "prBodyTemplate": "{{{header}}}\n\n{{{table}}}\n\n{{{notes}}}\n\n{{{changelogs}}}\n\n---\n\n{{{footer}}}"
}
