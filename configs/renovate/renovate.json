{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    ":separateMajorReleases",
    "group:monorepos",
    "group:recommended",
    "schedule:weekly"
  ],
  "timezone": "Europe/Lisbon",
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "prHourlyLimit": 4,
  "prConcurrentLimit": 10,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "vulnerability"],
    "schedule": [],
    "prPriority": 10
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"]
  },
  "packageRules": [
    {
      "description": "Auto-merge patch updates of dev/test deps, but never sooner than 3 days after release — a supply-chain compromise (malicious point release, then a fixed one days later) does not get an automatic branch merge in that window",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "3 days",
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Auto-merge minor updates of safe categories, same 3-day floor",
      "matchPackageNames": ["@types/**", "eslint*", "prettier*", "@typescript-eslint/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "minimumReleaseAge": "3 days",
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Group all linting tools",
      "matchPackageNames": ["*eslint*", "*prettier*", "*stylelint*", "*ruff*", "*black*", "*isort*"],
      "groupName": "linting tools"
    },
    {
      "description": "Group testing tools",
      "matchPackageNames": ["*jest*", "*vitest*", "*mocha*", "*pytest*", "*phpunit*", "*playwright*"],
      "groupName": "testing tools"
    },
    {
      "description": "Pin GitHub Actions to digests for security",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "Major updates need manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major-update", "needs-review"]
    }
  ],
  "ignoreDeps": [],
  "commitMessagePrefix": "chore(deps):",
  "prBodyTemplate": "{{{header}}}\n\n{{{table}}}\n\n{{{notes}}}\n\n{{{changelogs}}}\n\n---\n\n{{{footer}}}"
}
