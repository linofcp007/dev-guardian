{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    ":separateMajorReleases",
    "group:monorepos",
    "group:recommended",
    "schedule:weekly"
  ],
  "timezone": "Europe/Lisbon",
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "prHourlyLimit": 4,
  "prConcurrentLimit": 10,
  "minimumReleaseAge": "7 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "vulnerability"],
    "schedule": [],
    "prPriority": 10,
    "minimumReleaseAge": null
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"]
  },
  "packageRules": [
    {
      "description": "Paranoid: nothing auto-merges, ever — not even patch updates of dev/test deps. A human reads every PR before it lands, which is the whole point of this profile.",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch"],
      "automerge": false
    },
    {
      "description": "Paranoid: same for the categories the standard profile auto-merges (types, eslint, prettier)",
      "matchPackageNames": ["@types/**", "eslint*", "prettier*", "@typescript-eslint/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": false
    },
    {
      "description": "Group all linting tools",
      "matchPackageNames": ["*eslint*", "*prettier*", "*stylelint*", "*ruff*", "*black*", "*isort*"],
      "groupName": "linting tools"
    },
    {
      "description": "Group testing tools",
      "matchPackageNames": ["*jest*", "*vitest*", "*mocha*", "*pytest*", "*phpunit*", "*playwright*"],
      "groupName": "testing tools"
    },
    {
      "description": "Pin GitHub Actions to digests for security",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "Major updates need manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major-update", "needs-review"]
    }
  ],
  "ignoreDeps": [],
  "commitMessagePrefix": "chore(deps):",
  "prBodyTemplate": "{{{header}}}\n\n{{{table}}}\n\n{{{notes}}}\n\n{{{changelogs}}}\n\n---\n\n{{{footer}}}"
}
