{
  "name": "@dev-guardian/mcp-server",
  "version": "1.0.0",
  "description": "All-in-one open-source security, bugfix, quality, deps, observability, performance and compliance toolkit for AI coding hosts — an MCP server (50 tools, 16 resources) plus the `dev-guardian mcp-config` CLI that wires it into Cursor, Windsurf, Copilot, Codex, Gemini, Cline and Claude Desktop. Stack-aware (Node, Python, PHP/WordPress, C#/.NET, Go, Rust, Ruby, Java). Local-only, no telemetry. Trilingual EN/PT/ES.",
  "type": "module",
  "bin": {
    "dev-guardian": "bin/dev-guardian.mjs",
    "dev-guardian-mcp": "mcp/dist/server.js"
  },
  "files": [
    "bin/",
    "mcp/dist/",
    "host-rules/",
    "configs/",
    "scripts/",
    "skills/",
    "commands/",
    ".claude-plugin/",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "better-sqlite3": "^11.3.0",
    "execa": "^9.5.1",
    "zod": "^3.23.8"
  },
  "scripts": {
    "build": "npm --prefix mcp run build",
    "test": "npm --prefix mcp test",
    "prepublishOnly": "npm --prefix mcp ci && npm --prefix mcp run build && npm --prefix mcp test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "sast",
    "vulnerability-scanning",
    "code-review",
    "dependency-management",
    "sbom",
    "compliance",
    "semgrep",
    "trivy",
    "gitleaks",
    "cursor",
    "windsurf",
    "claude",
    "open-source"
  ],
  "homepage": "https://github.com/linofcp007/dev-guardian#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linofcp007/dev-guardian.git"
  },
  "bugs": {
    "url": "https://github.com/linofcp007/dev-guardian/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Carlos Pereira",
    "email": "carlospereira@prodigitalkey.com"
  },
  "publishConfig": {
    "access": "public"
  }
}
