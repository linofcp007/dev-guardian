{
  "description": "dev-guardian guardrails — secret detection on writes, catastrophic-command blocking on Bash and PowerShell, install-time package vetting on npm/pnpm/yarn/bun/pip/uv/poetry/composer/dotnet install commands (denies nonexistent or malicious packages, 3 s network budget), the hook configuration and Claude Code's settings guarded from Write/Edit and third-party MCP write tools, and a security-posture briefing at session start. Dependency-free and fail-open; exec form (Claude Code 2.1.139 or later); tune via .guardian/hooks.config.json (a project file cannot switch a protective hook off) or disable with GUARDIAN_HOOKS=off (package vetting alone: GUARDIAN_PKG_VET=0).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guardian-hook.mjs", "SessionStart"],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit|mcp__.+__[\\w-]*?([Ww][Rr][Ii][Tt][Ee]|[Ee][Dd][Ii][Tt]|[Cc][Rr][Ee][Aa][Tt][Ee]|[Mm][Oo][Vv][Ee]|[Rr][Ee][Nn][Aa][Mm][Ee]|[Cc][Oo][Pp][Yy]|[Aa][Pp][Pp][Ee][Nn][Dd]|[Pp][Aa][Tt][Cc][Hh]|[Rr][Ee][Pp][Ll][Aa][Cc][Ee]|[Ss][Aa][Vv][Ee]|[Pp][Uu][Tt]|[Uu][Pp][Ll][Oo][Aa][Dd]|[Ii][Nn][Ss][Ee][Rr][Tt])[\\w-]*|mcp__.+__(?:[\\w-]*[_-])?(?:update|modify|apply|set|push|UPDATE|MODIFY|APPLY|SET|PUSH|Update|Modify|Apply|Set|Push)(?:[A-Z_-][\\w-]*)?|mcp__.+__[\\w-]*[a-z0-9](?:Update|Modify|Apply|Set|Push)(?:[A-Z_-][\\w-]*)?)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guardian-hook.mjs", "PostToolUse"],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guardian-hook.mjs", "PreToolUse"],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit|mcp__.+__[\\w-]*?([Ww][Rr][Ii][Tt][Ee]|[Ee][Dd][Ii][Tt]|[Cc][Rr][Ee][Aa][Tt][Ee]|[Mm][Oo][Vv][Ee]|[Rr][Ee][Nn][Aa][Mm][Ee]|[Cc][Oo][Pp][Yy]|[Aa][Pp][Pp][Ee][Nn][Dd]|[Pp][Aa][Tt][Cc][Hh]|[Rr][Ee][Pp][Ll][Aa][Cc][Ee]|[Ss][Aa][Vv][Ee]|[Pp][Uu][Tt]|[Uu][Pp][Ll][Oo][Aa][Dd]|[Ii][Nn][Ss][Ee][Rr][Tt]|[Dd][Ee][Ll][Ee][Tt][Ee]|[Rr][Ee][Mm][Oo][Vv][Ee]|[Uu][Nn][Ll][Ii][Nn][Kk])[\\w-]*|mcp__.+__(?:[\\w-]*[_-])?(?:update|modify|apply|set|push|UPDATE|MODIFY|APPLY|SET|PUSH|Update|Modify|Apply|Set|Push)(?:[A-Z_-][\\w-]*)?|mcp__.+__[\\w-]*[a-z0-9](?:Update|Modify|Apply|Set|Push)(?:[A-Z_-][\\w-]*)?)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guardian-hook.mjs", "PreToolUse"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
