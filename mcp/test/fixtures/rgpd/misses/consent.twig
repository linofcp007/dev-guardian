{# A Twig layout that prints trackers only for the categories accepted.
   NOTHING here may fire (the template-condition guard, Twig form). #}
<!doctype html>
<html lang="{{ app.request.locale }}">
<head>
  {% if consent.analytics %}
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ ga_id }}"></script>
    <script>
      (function(h,o,t,j,a,r){
        h.hj=h.hj||function(){(h.hj.q=h.hj.q||[]).push(arguments)};
        h._hjSettings={hjid:{{ hotjar_id }},hjsv:6};
        a=o.getElementsByTagName('head')[0];
        r=o.createElement('script');r.async=1;
        r.src=t+h._hjSettings.hjid+j+h._hjSettings.hjsv;
        a.appendChild(r);
      })(window,document,'https://static.hotjar.com/c/hotjar-','.js?sv=');
    </script>
  {% endif %}
  {%- if consent.marketing -%}
    <script>fbq('init', '{{ pixel_id }}');</script>
  {%- endif -%}
</head>
<body>
  {% if consent.marketing %}
    <iframe src="https://www.youtube.com/embed/{{ video_id }}"></iframe>
  {% endif %}
  {# The THEN arm is still guarded when an ELSE follows it. #}
  {% if consent.marketing %}
    <iframe src="https://www.youtube.com/embed/{{ video_id }}?t=2"></iframe>
  {% else %}
    <p>O video aparece depois de aceitar os cookies de marketing.</p>
  {% endif %}
</body>
</html>
