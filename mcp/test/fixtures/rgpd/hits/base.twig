{# A Twig base layout (Symfony, Craft, Drupal). Each BUG fires
   rgpd-tracker-ga4-without-consent exactly once. #}
<!doctype html>
<html lang="{{ app.request.locale }}">
<head>
  {# BUG #}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ ga_id }}"></script>
  {% if app.environment == 'prod' %}
    {# BUG: a Twig condition, but not a consent one #}
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ ga_prod_id }}"></script>
  {% endif %}
  {% if not consent.analytics %}
    {# BUG: a NEGATED consent condition #}
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ ga_other_id }}"></script>
  {% endif %}
  {% block head %}{% endblock %}
</head>
<body>{% block body %}{% endblock %}</body>
</html>
