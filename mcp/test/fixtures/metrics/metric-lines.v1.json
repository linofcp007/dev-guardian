{
  "format": "metric-lines/1",
  "about": "The METRIC line contract of dev-spec-driven 1.41.0 and dev-guardian 3.17.0: written once, kept byte-identical in both repositories, each suite pinning its sha256. A change is metric-lines/2, a new file landed in both before either tags.",
  "grammar": {
    "line": "METRIC <name>=<number>[ <unit>][ better=lower|higher][ tolerance=<n>[%]][ <key>=<value>...]",
    "start": "at a line's start, after blanks (spaces, tabs) or one '# ', or both; a CR before the LF is no part of the line",
    "attempt": "a line whose first token after METRIC holds '='; an attempt that fails the grammar is malformed, any other METRIC line is ignored",
    "name": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,63}$",
    "number": "^-?(?:0|[1-9][0-9]{0,14})(?:\\.[0-9]{1,9})?(?:[eE][-+]?[0-9]{1,3})?$",
    "numberFinite": true,
    "unitMaxChars": 16,
    "keys": [ "better", "tolerance" ],
    "better": [ "lower", "higher" ],
    "unknownKeys": "ignored",
    "repeats": "the last line of a name wins, whole; the lines it replaced are counted"
  },
  "bounds": {
    "readBytes": 67108864,
    "candidateBytes": 512,
    "candidates": 1000,
    "names": 20
  },
  "boundsNote": "one set for both readers: at most readBytes of output read, a candidate line of at most candidateBytes, at most candidates candidate lines walked from the END (indexOf, never a split), at most names names kept; a bound that drops input says so",
  "judgeRule": "The terms (better=, tolerance=, the unit) are the reference's; the current line may only tighten: the smaller stated tolerance applies. A flipped or dropped better=, a raised or dropped tolerance or a changed unit is said once as loosened, and the value is judged by the reference's terms; a changed unit is not compared. No defaults: without a stated direction and tolerance the verdict is unjudged, with its delta. n% is n percent of |reference|; the boundary is inclusive; values compare as exact decimals.",
  "vocabulary": {
    "kinds": [ "metric", "malformed", "ignored" ],
    "verdicts": [ "new", "within", "improved", "regressed", "unjudged" ],
    "terms": [ "better", "tolerance", "unit" ],
    "bounds": [ "readBytes", "candidateBytes", "candidates", "names" ]
  },
  "fields": {
    "lines": "one line read alone. expect.kind: metric (name, value, unit, better, tolerance), malformed or ignored",
    "outputs": "a whole output read at once. expect.metrics: the reading of each name kept; repeats: the lines a later line of the same name replaced; malformed: the failed attempts; dropped: the bounds that dropped input",
    "judge": "reference (null: no earlier reading) and current are lines. expect.verdict; why (unjudged only): the terms that kept it from a judgment; loosened: the term the current line loosened, said beside the verdict; delta: current - reference; applied: the absolute tolerance the verdict used",
    "value": "a finite JSON number: the printed decimal read with Number(); delta and applied are exact decimals read the same way",
    "tolerance": "null, or {amount, percent}: percent true is a share of |reference|, false an amount in the value's own units",
    "absent": "null, never a missing key"
  },
  "lines": [
    { "id": "full-form", "text": "METRIC bundle-size=142.3 kB better=lower tolerance=2%", "expect": { "kind": "metric", "name": "bundle-size", "value": 142.3, "unit": "kB", "better": "lower", "tolerance": { "amount": 2, "percent": true } }, "note": "every slot: a name with '-', a unit, a direction, a tolerance as a share of the reference" },
    { "id": "bare-name-value", "text": "METRIC competitor_delta_patch_stdin_available=0", "expect": { "kind": "metric", "name": "competitor_delta_patch_stdin_available", "value": 0, "unit": null, "better": null, "tolerance": null }, "note": "a shape printed today: a 38-character name, no unit, no terms" },
    { "id": "dotted-absolute", "text": "METRIC lighthouse.performance=91 better=higher tolerance=2", "expect": { "kind": "metric", "name": "lighthouse.performance", "value": 91, "unit": null, "better": "higher", "tolerance": { "amount": 2, "percent": false } }, "note": "a dotted name; a tolerance without % is in the value's own units" },
    { "id": "tap-hash", "text": "# METRIC p95_ms=212 ms better=lower tolerance=10%", "expect": { "kind": "metric", "name": "p95_ms", "value": 212, "unit": "ms", "better": "lower", "tolerance": { "amount": 10, "percent": true } }, "note": "node's TAP reporter prints a test's stdout as '# <line>'" },
    { "id": "tap-nested-diagnostic", "text": "    # METRIC parse.ms=3 ms", "expect": { "kind": "metric", "name": "parse.ms", "value": 3, "unit": "ms", "better": null, "tolerance": null }, "note": "blanks, then '# ': a diagnostic of a nested subtest in node's TAP reporter" },
    { "id": "indented-spaces", "text": "    METRIC heap_mb=48.25 MB", "expect": { "kind": "metric", "name": "heap_mb", "value": 48.25, "unit": "MB", "better": null, "tolerance": null }, "note": "a console.log as Jest prints it, indented" },
    { "id": "indented-tab", "text": "\tMETRIC tests.count=812 better=higher tolerance=0", "expect": { "kind": "metric", "name": "tests.count", "value": 812, "unit": null, "better": "higher", "tolerance": { "amount": 0, "percent": false } }, "note": "a tab is a blank; tolerance=0 is a stated tolerance" },
    { "id": "bare-word-is-a-unit", "text": "METRIC tests.count=812 higher", "expect": { "kind": "metric", "name": "tests.count", "value": 812, "unit": "higher", "better": null, "tolerance": null }, "note": "there is no bare direction: the token after the number is the unit" },
    { "id": "unknown-key", "text": "METRIC p95=12 ms better=lower runs=5", "expect": { "kind": "metric", "name": "p95", "value": 12, "unit": "ms", "better": "lower", "tolerance": null }, "note": "runs= is no known key: ignored" },
    { "id": "upper-exponent-keys", "text": "METRIC Total.Ops=1.5e3 ops/s better=higher tolerance=5% spread=0.8", "expect": { "kind": "metric", "name": "Total.Ops", "value": 1500, "unit": "ops/s", "better": "higher", "tolerance": { "amount": 5, "percent": true } }, "note": "an uppercase name, an exponent, a unit with '/', an unknown key after the known ones" },
    { "id": "negative", "text": "METRIC balance.delta=-3.5", "expect": { "kind": "metric", "name": "balance.delta", "value": -3.5, "unit": null, "better": null, "tolerance": null } },
    { "id": "percent-unit", "text": "METRIC coverage=87.5 % better=higher tolerance=0.5", "expect": { "kind": "metric", "name": "coverage", "value": 87.5, "unit": "%", "better": "higher", "tolerance": { "amount": 0.5, "percent": false } }, "note": "a % unit; tolerance=0.5 is half a point, never half a percent of 87.5" },
    { "id": "name-64", "text": "METRIC x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcde=1", "expect": { "kind": "metric", "name": "x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcde", "value": 1, "unit": null, "better": null, "tolerance": null }, "note": "a name of 64 characters, the longest" },
    { "id": "name-non-ascii", "text": "METRIC total_\u00b5s=15200", "expect": { "kind": "malformed" }, "note": "a name is ASCII: cmd.exe turns the micro sign into U+FFFD" },
    { "id": "name-65", "text": "METRIC x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef=1", "expect": { "kind": "malformed" }, "note": "a name of 65 characters" },
    { "id": "name-leading-dash", "text": "METRIC -x=1", "expect": { "kind": "malformed" }, "note": "a name starts with a letter, a digit or '_'" },
    { "id": "name-empty", "text": "METRIC =5", "expect": { "kind": "malformed" } },
    { "id": "value-empty", "text": "METRIC x=", "expect": { "kind": "malformed" } },
    { "id": "value-overflow", "text": "METRIC x=1e400", "expect": { "kind": "malformed" }, "note": "the number must be finite" },
    { "id": "value-infinity", "text": "METRIC x=Infinity", "expect": { "kind": "malformed" } },
    { "id": "value-nan", "text": "METRIC x=NaN", "expect": { "kind": "malformed" } },
    { "id": "value-comma", "text": "METRIC x=1,5", "expect": { "kind": "malformed" }, "note": "no locale decimals" },
    { "id": "value-unit-glued", "text": "METRIC size=142.3kB", "expect": { "kind": "malformed" }, "note": "the unit is a token of its own" },
    { "id": "two-bare-tokens", "text": "METRIC x=5 higher lower", "expect": { "kind": "malformed" }, "note": "one unit at most: 'lower' is neither a unit nor a key=value" },
    { "id": "better-bad", "text": "METRIC x=5 better=up", "expect": { "kind": "malformed" }, "note": "a known key with a value outside its grammar" },
    { "id": "tolerance-bad", "text": "METRIC x=5 ms tolerance=five", "expect": { "kind": "malformed" }, "note": "a known key with a value outside its grammar" },
    { "id": "unit-17", "text": "METRIC x=5 abcdefghijklmnopq", "expect": { "kind": "malformed" }, "note": "a unit has at most 16 characters" },
    { "id": "table-header", "text": "METRIC   | BEFORE (Serial) | AFTER (Parallel)", "expect": { "kind": "ignored" }, "note": "a benchmark table's header: no attempt, not malformed" },
    { "id": "json-payload", "text": "METRIC {\"metric\": \"latency\", \"value\": 12.5}", "expect": { "kind": "ignored" }, "note": "the first token holds no '='" },
    { "id": "log-metric", "text": "METRIC confidence 0.93", "expect": { "kind": "ignored" }, "note": "a log line of another tool: no attempt" },
    { "id": "lowercase", "text": "metric x=1", "expect": { "kind": "ignored" }, "note": "the keyword is uppercase" },
    { "id": "two-hashes", "text": "## METRIC x=1", "expect": { "kind": "ignored" }, "note": "one '# ' at most" },
    { "id": "hash-no-space", "text": "#METRIC x=1", "expect": { "kind": "ignored" }, "note": "the hash is '# ', with its space" },
    { "id": "shell-trace", "text": "+ echo 'METRIC x=1'", "expect": { "kind": "ignored" }, "note": "a shell's trace of the command that prints the line" },
    { "id": "keyword-prefix", "text": "METRICS x=1", "expect": { "kind": "ignored" } },
    { "id": "keyword-alone", "text": "METRIC", "expect": { "kind": "ignored" } }
  ],
  "outputs": [
    { "id": "repeat-last-wins", "text": "METRIC bundle-size=118 kB better=lower tolerance=2%\nbuilding the bundle\nMETRIC bundle-size=120 kB\n", "expect": { "metrics": { "bundle-size": { "value": 120, "unit": "kB", "better": null, "tolerance": null } }, "repeats": 1, "malformed": 0, "dropped": [] }, "note": "the last line of a name wins whole: its terms are never merged with an earlier line's" },
    { "id": "crlf", "text": "METRIC p95_ms=212 ms better=lower tolerance=10%\r\nok 1 - load\r\n", "expect": { "metrics": { "p95_ms": { "value": 212, "unit": "ms", "better": "lower", "tolerance": { "amount": 10, "percent": true } } }, "repeats": 0, "malformed": 0, "dropped": [] }, "note": "a CR before the LF is no part of the line" },
    { "id": "tap-run", "text": "TAP version 13\n# METRIC bundle-size=142.3 kB better=lower tolerance=2%\n# Subtest: size\nok 1 - size\n  ---\n  duration_ms: 1.52\n  type: 'test'\n  ...\n1..1\n# tests 1\n# pass 1\n# fail 0\n", "expect": { "metrics": { "bundle-size": { "value": 142.3, "unit": "kB", "better": "lower", "tolerance": { "amount": 2, "percent": true } } }, "repeats": 0, "malformed": 0, "dropped": [] }, "note": "node --test --test-reporter=tap, as node 26 prints a test's console.log" },
    { "id": "mixed", "text": "METRIC   | BEFORE (Serial) | AFTER (Parallel) |\nMETRIC parse_ms=41.7 ms better=lower tolerance=15%\nMETRIC total_\u00b5s=15200\nMETRIC confidence 0.93\n", "expect": { "metrics": { "parse_ms": { "value": 41.7, "unit": "ms", "better": "lower", "tolerance": { "amount": 15, "percent": true } } }, "repeats": 0, "malformed": 1, "dropped": [] }, "note": "one reading, one failed attempt counted, two ignored lines not counted" },
    { "id": "names-cap", "text": "METRIC m01=1\nMETRIC m02=2\nMETRIC m03=3\nMETRIC m04=4\nMETRIC m05=5\nMETRIC m06=6\nMETRIC m07=7\nMETRIC m08=8\nMETRIC m09=9\nMETRIC m10=10\nMETRIC m11=11\nMETRIC m12=12\nMETRIC m13=13\nMETRIC m14=14\nMETRIC m15=15\nMETRIC m16=16\nMETRIC m17=17\nMETRIC m18=18\nMETRIC m19=19\nMETRIC m20=20\nMETRIC m21=21\n", "expect": { "metrics": { "m02": { "value": 2, "unit": null, "better": null, "tolerance": null }, "m03": { "value": 3, "unit": null, "better": null, "tolerance": null }, "m04": { "value": 4, "unit": null, "better": null, "tolerance": null }, "m05": { "value": 5, "unit": null, "better": null, "tolerance": null }, "m06": { "value": 6, "unit": null, "better": null, "tolerance": null }, "m07": { "value": 7, "unit": null, "better": null, "tolerance": null }, "m08": { "value": 8, "unit": null, "better": null, "tolerance": null }, "m09": { "value": 9, "unit": null, "better": null, "tolerance": null }, "m10": { "value": 10, "unit": null, "better": null, "tolerance": null }, "m11": { "value": 11, "unit": null, "better": null, "tolerance": null }, "m12": { "value": 12, "unit": null, "better": null, "tolerance": null }, "m13": { "value": 13, "unit": null, "better": null, "tolerance": null }, "m14": { "value": 14, "unit": null, "better": null, "tolerance": null }, "m15": { "value": 15, "unit": null, "better": null, "tolerance": null }, "m16": { "value": 16, "unit": null, "better": null, "tolerance": null }, "m17": { "value": 17, "unit": null, "better": null, "tolerance": null }, "m18": { "value": 18, "unit": null, "better": null, "tolerance": null }, "m19": { "value": 19, "unit": null, "better": null, "tolerance": null }, "m20": { "value": 20, "unit": null, "better": null, "tolerance": null }, "m21": { "value": 21, "unit": null, "better": null, "tolerance": null } }, "repeats": 0, "malformed": 0, "dropped": [ "names" ] }, "note": "21 names: the walk from the end keeps the 20 printed last; m01 is dropped, and the drop is said" }
  ],
  "judge": [
    { "id": "exact-boundary", "reference": "METRIC bundle-size=120 kB better=lower tolerance=2%", "current": "METRIC bundle-size=122.4 kB better=lower tolerance=2%", "expect": { "verdict": "within", "why": null, "loosened": null, "delta": 2.4, "applied": 2.4 }, "note": "2% of 120 is 2.4 exactly; in binary floating point 122.4 - 120 is 2.4000000000000057" },
    { "id": "past-boundary", "reference": "METRIC bundle-size=120 kB better=lower tolerance=2%", "current": "METRIC bundle-size=122.41 kB better=lower tolerance=2%", "expect": { "verdict": "regressed", "why": null, "loosened": null, "delta": 2.41, "applied": 2.4 } },
    { "id": "zero-reference", "reference": "METRIC bundle.gz=0 B better=lower tolerance=5%", "current": "METRIC bundle.gz=10 B better=lower tolerance=5%", "expect": { "verdict": "regressed", "why": null, "loosened": null, "delta": 10, "applied": 0 }, "note": "5% of |0| is 0" },
    { "id": "improved", "reference": "METRIC bundle-size=120 kB better=lower tolerance=2%", "current": "METRIC bundle-size=110 kB better=lower tolerance=2%", "expect": { "verdict": "improved", "why": null, "loosened": null, "delta": -10, "applied": 2.4 } },
    { "id": "unchanged", "reference": "METRIC bundle-size=120 kB better=lower tolerance=2%", "current": "METRIC bundle-size=120 kB better=lower tolerance=2%", "expect": { "verdict": "within", "why": null, "loosened": null, "delta": 0, "applied": 2.4 } },
    { "id": "share-of-reference", "reference": "METRIC throughput=100 req/s better=higher tolerance=10%", "current": "METRIC throughput=90 req/s better=higher tolerance=10%", "expect": { "verdict": "within", "why": null, "loosened": null, "delta": -10, "applied": 10 }, "note": "10% of the reference (100), never of the current value (90)" },
    { "id": "count-tolerance-zero", "reference": "METRIC tests.count=812 better=higher tolerance=0", "current": "METRIC tests.count=811 better=higher tolerance=0", "expect": { "verdict": "regressed", "why": null, "loosened": null, "delta": -1, "applied": 0 } },
    { "id": "absolute-decimal", "reference": "METRIC error_rate=0.7 % better=lower tolerance=0.07", "current": "METRIC error_rate=0.77 % better=lower tolerance=0.07", "expect": { "verdict": "within", "why": null, "loosened": null, "delta": 0.07, "applied": 0.07 } },
    { "id": "share-decimal", "reference": "METRIC miss_ratio=0.3 better=lower tolerance=10%", "current": "METRIC miss_ratio=0.33 better=lower tolerance=10%", "expect": { "verdict": "within", "why": null, "loosened": null, "delta": 0.03, "applied": 0.03 } },
    { "id": "negative-reference", "reference": "METRIC balance.delta=-10 better=higher tolerance=10%", "current": "METRIC balance.delta=-10.5 better=higher tolerance=10%", "expect": { "verdict": "within", "why": null, "loosened": null, "delta": -0.5, "applied": 1 }, "note": "a share of |reference|: 10% of |-10| is 1" },
    { "id": "tightened", "reference": "METRIC p95_ms=100 ms better=lower tolerance=5%", "current": "METRIC p95_ms=104 ms better=lower tolerance=2%", "expect": { "verdict": "regressed", "why": null, "loosened": null, "delta": 4, "applied": 2 }, "note": "the current line may tighten: the smaller stated tolerance applies" },
    { "id": "tightened-across-kinds", "reference": "METRIC p95_ms=200 ms better=lower tolerance=5%", "current": "METRIC p95_ms=208 ms better=lower tolerance=6", "expect": { "verdict": "regressed", "why": null, "loosened": null, "delta": 8, "applied": 6 }, "note": "tolerances compare as amounts: 5% of 200 is 10, the current's 6 is smaller and applies" },
    { "id": "tolerance-raised", "reference": "METRIC p95_ms=100 ms better=lower tolerance=2%", "current": "METRIC p95_ms=104 ms better=lower tolerance=10%", "expect": { "verdict": "regressed", "why": null, "loosened": "tolerance", "delta": 4, "applied": 2 }, "note": "said once as loosened; judged by the reference's 2%" },
    { "id": "tolerance-dropped", "reference": "METRIC p95_ms=100 ms better=lower tolerance=2%", "current": "METRIC p95_ms=101 ms better=lower", "expect": { "verdict": "within", "why": null, "loosened": "tolerance", "delta": 1, "applied": 2 } },
    { "id": "better-flipped", "reference": "METRIC bundle-size=100 kB better=lower tolerance=2%", "current": "METRIC bundle-size=150 kB better=higher tolerance=2%", "expect": { "verdict": "regressed", "why": null, "loosened": "better", "delta": 50, "applied": 2 }, "note": "judged by the reference's direction" },
    { "id": "better-dropped", "reference": "METRIC bundle-size=100 kB better=lower tolerance=2%", "current": "METRIC bundle-size=150 kB tolerance=2%", "expect": { "verdict": "regressed", "why": null, "loosened": "better", "delta": 50, "applied": 2 }, "note": "a dropped direction never escapes the judgment" },
    { "id": "unit-changed", "reference": "METRIC bundle-size=120 kB better=lower tolerance=2%", "current": "METRIC bundle-size=0.13 MB better=lower tolerance=2%", "expect": { "verdict": "unjudged", "why": [ "unit" ], "loosened": "unit", "delta": null, "applied": null }, "note": "a changed unit is not compared: no delta, no conversion" },
    { "id": "no-direction", "reference": "METRIC build_s=31.4 s tolerance=5%", "current": "METRIC build_s=33 s tolerance=5%", "expect": { "verdict": "unjudged", "why": [ "better" ], "loosened": null, "delta": 1.6, "applied": null }, "note": "no defaults: shown with its delta, never judged" },
    { "id": "no-tolerance", "reference": "METRIC build_s=31.4 s better=lower", "current": "METRIC build_s=33 s better=lower", "expect": { "verdict": "unjudged", "why": [ "tolerance" ], "loosened": null, "delta": 1.6, "applied": null } },
    { "id": "no-terms", "reference": "METRIC total_us=15200", "current": "METRIC total_us=16100", "expect": { "verdict": "unjudged", "why": [ "better", "tolerance" ], "loosened": null, "delta": 900, "applied": null }, "note": "the shape benchmark loops print today" },
    { "id": "new", "reference": null, "current": "METRIC queries_per_request=7 better=lower tolerance=0", "expect": { "verdict": "new", "why": null, "loosened": null, "delta": null, "applied": null }, "note": "no earlier reading of the name" }
  ]
}
